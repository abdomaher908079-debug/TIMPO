# Domain pointing at this server, e.g. cloud.hookcut.app (Caddy gets its HTTPS certificate).
CLOUD_DOMAIN=
# Supabase → Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secret: never share it or put it in the website.
SUPABASE_SERVICE_ROLE_KEY=
# Your website's address(es), comma separated, e.g. https://hookcut.app
ALLOWED_ORIGINS=
