# Copy to .env.local and fill in. Never commit real keys.

# Supabase (Project Settings → API). Empty = demo mode (fake logins).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# "on" shows "Continue with Google". Turn on the Google provider in Supabase (Authentication → Providers) first.
VITE_GOOGLE_LOGIN=

# Gemini (https://aistudio.google.com/apikey), free tier. Used by the local dev server in demo mode.
# No VITE_ prefix on purpose: it stays on the server and never reaches the browser.
# In production, set it on Supabase instead: supabase secrets set GEMINI_API_KEY=...
GEMINI_API_KEY=

# Paddle (payments). Public values only here; secrets go on Supabase (see README).
# sandbox while testing, production when live.
VITE_PADDLE_ENV=sandbox
# Developer tools → Authentication → client-side token (starts with test_ or live_).
VITE_PADDLE_CLIENT_TOKEN=
# Catalog → Products → each price's ID (pri_...).
VITE_PADDLE_PRICE_PRO_MONTHLY=
VITE_PADDLE_PRICE_PRO_YEARLY=
VITE_PADDLE_PRICE_STUDIO_MONTHLY=
VITE_PADDLE_PRICE_STUDIO_YEARLY=

# Optional: Gemini key from a Google Cloud project WITH billing on. Gives Pro and Studio the "Best AI"
# (Gemini's top model). Until it's set, paid plans use the strongest free model. Set on Supabase too.
GEMINI_PAID_API_KEY=
# Optional model overrides. Defaults: quick = gemini-flash-lite-latest, best = gemini-pro-latest.
GEMINI_MODEL_QUICK=
GEMINI_MODEL_BEST=

# Cloud processing server (server/), e.g. https://cloud.hookcut.app. Empty = option hidden.
VITE_CLOUD_URL=

# Shown on the Privacy, Terms and Refund pages: your name or company, and a support email.
VITE_LEGAL_NAME=
VITE_SUPPORT_EMAIL=

# Address of the speech runtime's 27 MB file (ort-wasm-simd-threaded.asyncify.wasm) on the live site.
# Too big for Cloudflare Pages, so it's hosted separately: your Cloudflare R2 copy (see LAUNCH.md).
# Empty = the free jsDelivr CDN.
VITE_SPEECH_RUNTIME_URL=
