# Copy to .env.local and fill in. Never commit real keys.

# Supabase (Project Settings → API). Empty = demo mode (fake logins).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini (https://aistudio.google.com/apikey), free tier. Used by the local dev server in demo mode.
# No VITE_ prefix on purpose: it stays on the server and never reaches the browser.
# In production, set it on Supabase instead: supabase secrets set GEMINI_API_KEY=...
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-latest.
GEMINI_MODEL=

# Paddle (payments). Public values only here; secrets go on Supabase (see README).
# sandbox while testing, production when live.
VITE_PADDLE_ENV=sandbox
# Developer tools → Authentication → client-side token (starts with test_ or live_).
VITE_PADDLE_CLIENT_TOKEN=
# Catalog → Products → each price's ID (pri_...).
VITE_PADDLE_PRICE_PRO_MONTHLY=
VITE_PADDLE_PRICE_PRO_YEARLY=
VITE_PADDLE_PRICE_STUDIO_MONTHLY=
VITE_PADDLE_PRICE_STUDIO_YEARLY=
