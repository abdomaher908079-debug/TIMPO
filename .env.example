# Copy to .env.local and fill in. Never commit real keys.

# Supabase (Project Settings → API). Empty = demo mode (fake logins).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI. With no key at all, the site returns fixed sample answers.
# Free: get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Paid, for later: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: force a provider (gemini | claude | sample) or a model.
AI_PROVIDER=
GEMINI_MODEL=
CLAUDE_MODEL=
